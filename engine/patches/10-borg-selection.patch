Share the Ctrl-Z prompt and Borg switching between the C and Rust Borgs. Guarded by BORG_HARNESS.

--- a/src/cmd-misc.c
+++ b/src/cmd-misc.c
@@ -24,6 +24,11 @@
 #include "game-input.h"
 #include "init.h"
 #include "mon-lore.h"
+#ifdef BORG_HARNESS
+#include "ui-output.h"
+#include "ui-term.h"
+#include "z-textblock.h"
+#endif
 #include "mon-util.h"
 #include "player-calcs.h"
 #include "player-history.h"
@@ -109,6 +114,100 @@
 
 extern void do_cmd_borg(void);
 
+#ifdef BORG_HARNESS
+extern void do_cmd_cborg_key(int cmd);
+extern void do_cmd_pborg(unsigned char cmd);
+
+static bool use_cborg;
+
+static void greet_selected_borg(void)
+{
+	static bool pborg_introduced;
+
+	if (use_cborg) {
+		/* Ben Harrison's Angband page and the historical APWBorg readme. */
+		msg("(Original C-Borg by Ben Harrison, extended by Andrew P. White.)");
+	} else if (pborg_introduced) {
+		msg("(P-Borg, partial rewrite of the Borg by Diego Amicabile)");
+	} else {
+		textblock *greeting = textblock_new();
+		textblock_append(greeting,
+			"Hi, I am the P-Borg, a partial rewrite of the original Borg "
+			"in Rust, whose main focus is survivability.\n\n"
+			"You are more likely to get bored than to die with us.\n\n"
+			"P-Borg includes the borg-rs port of C-Borg and the reborn rewrite.");
+		textui_textblock_show(greeting, SCREEN_REGION, "P-Borg");
+		textblock_free(greeting);
+		pborg_introduced = true;
+	}
+}
+
+void borg_switch_selection(void)
+{
+	use_cborg = !use_cborg;
+}
+
+static void run_selected_borg_command(char cmd)
+{
+	if (cmd == 'B') {
+		borg_switch_selection();
+		return;
+	}
+	/* Keep interactive greetings out of deterministic replays. */
+	if (cmd == 'z' && !streq(ANGBAND_SYS, "borgh"))
+		greet_selected_borg();
+	if (use_cborg)
+		do_cmd_cborg_key((unsigned char)cmd);
+	else
+		do_cmd_pborg((unsigned char)cmd);
+}
+
+/* The fallback help mirrors borg-reborn-rs/src/borg.rs's command():
+ * z starts the core. B and ? are shared prompt commands. */
+void do_cmd_reborn_borg_help(void)
+{
+	char cmd;
+	bool accepted;
+
+	Term_save();
+	Term_clear();
+	Term_putstr(2, 2, -1, COLOUR_WHITE, "Command 'z' activate borg");
+	Term_putstr(2, 3, -1, COLOUR_WHITE, "Command 'B' switch to CBorg");
+	do {
+		accepted = get_com("PBorg command (? for help): ", &cmd);
+	} while (accepted && cmd == '?');
+	Term_load();
+
+	if (!accepted)
+		return;
+	if (cmd == 'B' || cmd == 'z')
+		run_selected_borg_command(cmd);
+	else
+		msg("That is not a legal Borg command.");
+}
+
+static void do_cmd_selected_borg(void)
+{
+	const char *prompt = use_cborg
+		? "CBorg command (? for help): "
+		: "PBorg command (? for help): ";
+	bool was_cborg = use_cborg;
+	char cmd;
+
+	if (!get_com(prompt, &cmd))
+		return;
+	run_selected_borg_command(cmd);
+	/* A command entered in help may have switched Borgs. Greet after help
+	 * has restored the game screen. */
+	if (use_cborg != was_cborg) {
+		if (!streq(ANGBAND_SYS, "borgh"))
+			greet_selected_borg();
+		else
+			msg("%s selected. Press Ctrl-Z for commands.", use_cborg ? "CBorg" : "PBorg");
+	}
+}
+#endif
+
 /*
  * Verify use of "borg" mode
  */
@@ -131,7 +230,11 @@
 	}
 
 	/* Okay */
+#ifdef BORG_HARNESS
+	do_cmd_selected_borg();
+#else
 	do_cmd_borg();
+#endif
 }
 
 #endif /* ALLOW_BORG */

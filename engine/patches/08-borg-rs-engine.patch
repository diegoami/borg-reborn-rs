+extern errr Term_redraw_all(void)
+{
+	term *old = Term;
+	errr combined = 0;
+	bool first = true;
+	int j;
+
+	for (j = 0; j < ANGBAND_TERM_MAX; j++) {
+		errr one_result;
+
+		if (!angband_term[j]) continue;
